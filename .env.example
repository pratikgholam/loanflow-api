# Application
APP_NAME=loanflow-api
APP_ENV=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (async SQLAlchemy 2.0 + asyncpg driver)
DATABASE_URL=postgresql+asyncpg://loanflow:loanflow@localhost:5432/loanflow
TEST_DATABASE_URL=postgresql+asyncpg://loanflow:loanflow@localhost:5433/loanflow_test

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Seed admin (dev/test only, fake data)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-secret-change-me
